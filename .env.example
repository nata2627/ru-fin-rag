# Копия этого файла называется .env и не коммитится. Пустая обязательная переменная
# роняет конфигурацию громко: тихая подстановка значения по умолчанию скрыла бы
# опечатку в имени переменной на хостинге (SPEC, раздел 3).

# Боевой режим сервиса. Пусто или 0 это стройка, 1 это работа наружу.
RUFINRAG_LIVE=

# Корпус и артефакты поиска. По умолчанию берутся из data/ этого репозитория.
RUFINRAG_DATA_DIR=

# Файл связок поиска. Пусто значит configs/retrieval.yaml этого репозитория.
# Задается там, где пакет стоит в системе, а репозиторий лежит в другом месте.
RUFINRAG_CONFIG_PATH=

# Связка поиска по умолчанию. Пусто значит та, что стоит в configs/retrieval.yaml.
RUFINRAG_DEFAULT_CONFIG=

# 1 выключает плотную часть поиска: нужно там, где нет весов модели запроса.
RUFINRAG_DISABLE_DENSE=

# Чем считать плотный поиск: numpy (по умолчанию) или faiss. FAISS быстрее на
# 1 мс (2,1 мс против 3,1 мс), но в одном процессе с torch на маке падает,
# подробности в src/rufinrag/retrieval/dense.py.
RUFINRAG_DENSE_BACKEND=

# Куда сервис пишет журнал запросов. Пусто значит data/events этого репозитория.
# На хостинге задается путем вне клона (`/tmp/rufinrag-events`), иначе процесс
# дописывал бы в файл суток, приехавший из git.
RUFINRAG_EVENT_DIR=

# `off` выключает журнал запросов целиком. Нужно замерам, которым запись мешает.
RUFINRAG_EVENT_LOG=

# Секрет ручки `GET /events`, которой ночной прогон забирает журнал с хостинга.
# Пока переменной нет, ручка отвечает 404, а шаг выгрузки пропускается. Значение
# любая случайная строка (`openssl rand -hex 24`), одно и то же в двух местах:
# в переменных сервиса на Render и в секретах репозитория.
RUFINRAG_EVENTS_TOKEN=

# Адрес сервиса для прогонов, которые ходят к нему по сети (выгрузка журнала,
# замер задержки). Пусто значит https://ru-fin-rag.onrender.com.
RUFINRAG_SERVICE_URL=

# Токен HuggingFace. Логам он больше не нужен: они едут в репозиторий сервиса,
# потому что у встроенного токена прогона нет срока. Остается на случай, если
# датасет логов захочется отдельной ссылкой. Берется в настройках профиля
# HuggingFace, права на запись в свой датасет, срок пишется в README.
HF_TOKEN=

# Ключ генеративной модели (этап 7). Без ключа сервис отдает выдержки с
# цитатами, это нормальный режим, а не поломка.
RUFINRAG_LLM_API_KEY=

# Qdrant, если векторы живут не внутри образа (задача 1.5 и 2.4).
QDRANT_URL=
QDRANT_API_KEY=

# Адрес, по которому Render переразворачивает сервис из CI. Нужен только если
# деплой запускается из прогона, а не по пушу. Берется в настройках сервиса на
# Render: Settings, раздел Deploy Hook. Это ссылка с секретом внутри, в логи
# она не печатается.
RENDER_DEPLOY_HOOK=
