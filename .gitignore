# Сборка dbt: скомпилированные модели, отчет прогона и его лог. Это вывод
# `dbt build`, он пересобирается кодом из репозитория.
dbt/target/
.ruff_cache/
.pytest_cache/
*.log

# Данные сервиса. Фрагменты корпуса и эталонный набор едут в репозиторий
# (DECISIONS, решение 8), остальное пересобирается кодом или слишком велико
# для git.
!data/corpus/chunks.jsonl.gz
# Память ночного прогона о том, какие акты уже пробовали взять и не смогли.
!data/corpus/skipped.json
data/models/

# data/events не игнорируется: журнал запросов сервиса едет в репозиторий
# (DECISIONS, решение 12). События прогонов туда не попадают, потому что
# тестам каталог подменяет tests/conftest.py, а замеру нагрузки журнал
# выключен, а не потому, что об этом надо помнить.
